{
  "checks": [
    {
      "id": "plugin-build",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{repo}/adapters/hearth-ledger/Run.ps1", "-ProjectPath", "{project}", "-HdtPath", "{hdt}", "-OutputDirectory", "{output}/build", "-Mode", "Build"],
      "timeoutMs": 90000,
      "paths": ["^src/", "^Build\\.ps1$", "^README\\.md$", "^\\.gitignore$"]
    },
    {
      "id": "domain-regression",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "{repo}/adapters/hearth-ledger/Run.ps1", "-ProjectPath", "{project}", "-HdtPath", "{hdt}", "-OutputDirectory", "{output}/domain", "-Mode", "Domain"],
      "timeoutMs": 90000,
      "paths": ["^src/"]
    }
  ]
}
